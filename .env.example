# Sjabloon voor omgevingsvariabelen. Kopieer naar .env.local en vul in:
#   cp .env.example .env.local
#
# Variabelen met VITE_ ervoor worden door Vite in de browser-bundel gezet
# en zijn dus publiek zichtbaar. Zet er geen gevoelige admin-keys in.

# Volledige URL van de n8n Webhook-node (Production URL).
VITE_N8N_WEBHOOK_URL=

# Gedeeld token dat de app meestuurt ter verificatie in n8n.
VITE_N8N_WEBHOOK_TOKEN=
